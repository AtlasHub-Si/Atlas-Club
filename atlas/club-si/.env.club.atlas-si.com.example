# AtlasClub Campus Production Environment — club.atlas-si.com
# NUNCA commitar este arquivo preenchido com segredos reais!

# Postgres & Redis
POSTGRES_USER=atlasclub
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=atlasclub

# Core LearnHouse Security & Keys (gerar com: python3 -c "import secrets;print(secrets.token_urlsafe(32))")
LEARNHOUSE_AUTH_JWT_SECRET_KEY=change-me-jwt-secret-32-chars
COLLAB_INTERNAL_KEY=change-me-collab-internal-key
NEXTAUTH_SECRET=change-me-nextauth-secret-32-chars

# Domain & Multi-Tenancy (club.atlas-si.com)
LEARNHOUSE_SITE_NAME="AtlasClub"
LEARNHOUSE_DOMAIN=club.atlas-si.com
LEARNHOUSE_FRONTEND_DOMAIN=club.atlas-si.com
LEARNHOUSE_PUBLIC_URL=https://club.atlas-si.com
LEARNHOUSE_COOKIE_DOMAIN=.atlas-si.com
LEARNHOUSE_SSL=true
LEARNHOUSE_TENANCY=multi
LEARNHOUSE_SAAS=true
LEARNHOUSE_ALLOWED_ORIGINS=https://club.atlas-si.com,https://pay.atlashub.si
LEARNHOUSE_OSS=true

# Build / Runtime Public Flags
NEXT_PUBLIC_LEARNHOUSE_OSS=true
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=club.atlas-si.com
NEXT_PUBLIC_LEARNHOUSE_HTTPS=true
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://club.atlas-si.com/api/v1
NEXT_PUBLIC_LEARNHOUSE_COLLAB_URL=wss://club.atlas-si.com/collab
NEXT_PUBLIC_ATLAS_CLUBOS_BRAND=true

# Initial Super Admin
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@atlashub.si
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=change-me-initial-admin-pass

# SMTP Transacional (para reset de senha e convites)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=change-me-smtp-key
SMTP_FROM=AtlasClub <noreply@atlas-si.com>
